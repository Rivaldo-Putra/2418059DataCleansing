n\n","\n","    name = str(name).strip()\n","    name = re.sub(r'\\s+', ' ', name)\n","\n","    return name\n","\n","\n","data['Nama Bersih'] = data['Nama'].apply(clean_name)\n","\n","print(\"\\nHasil Standarisasi Nama:\")\n","print(data[['Nama', 'Nama Bersih']].head(10))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"jxsgc4Om1_FP","executionInfo":{"status":"ok","timestamp":1790865751030,"user_tz":-420,"elapsed":96,"user":{"displayName":"Rivaldo Putra","userId":"00887201100226386037"}},"outputId":"615666cd-1849-494b-8b19-1d2a3230eca0"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Hasil Standarisasi Nama:\n","             Nama     Nama Bersih\n","0    Andi Saputra    Andi Saputra\n","1     Maria Putri     Maria Putri\n","2    Budi Santoso    Budi Santoso\n","3    Siti Aminah      Siti Aminah\n","4    Rian Pratama    Rian Pratama\n","5    Dewi Lestari    Dewi Lestari\n","6    Andi Saputra    Andi Saputra\n","7   Fajar Hidayat   Fajar Hidayat\n","8    Nina Marlina    Nina Marlina\n","9  Rizky Ramadhan  Rizky Ramadhan\n"]}]},{"cell_type":"markdown","source":["# 6. DATA CLEANSING - STANDARISASI JENIS KELAMIN"],"metadata":{"id":"PRwKGTZt2Ezx"}},{"cell_type":"code","source":["def clean_gender(gender):\n","    if pd.isna(gender):\n","        return np.nan\n","\n","    gender = str(gender).strip().lower()\n","\n","    if gender in ['l', 'laki-laki', 'laki laki', 'male']:\n","        return 'Laki-laki'\n","\n","    elif gender in ['p', 'perempuan', 'female']:\n","        return 'Perempuan'\n","\n","    return np.nan\n","\n","\n","data['Jenis Kelamin Bersih'] = data['Jenis Kelamin'].apply(clean_gender)\n","\n","print(\"\\nHasil Standarisasi Jenis Kelamin:\")\n","print(data[['Jenis Kelamin', 'Jenis Kelamin Bersih']].head(15))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"7LNHbrhP2JNe","executionInfo":{"status":"ok","timestamp":1790865756072,"user_tz":-420,"elapsed":27,"user":{"displayName":"Rivaldo Putra","userId":"00887201100226386037"}},"outputId":"643e4654-0260-4237-aa1c-d3b5cd4972b1"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Hasil Standarisasi Jenis Kelamin:\n","   Jenis Kelamin Jenis Kelamin Bersih\n","0              L            Laki-laki\n","1      Perempuan            Perempuan\n","2      Laki-laki            Laki-laki\n","3              P            Perempuan\n","4              L            Laki-laki\n","5      Perempuan            Perempuan\n","6              L            Laki-laki\n","7      laki laki            Laki-laki\n","8              P            Perempuan\n","9      Laki-Laki            Laki-laki\n","10             L            Laki-laki\n","11     Perempuan            Perempuan\n","12             L            Laki-laki\n","13             P            Perempuan\n","14     Laki-laki            Laki-laki\n"]}]},{"cell_type":"markdown","source":["# 7. DATA CLEANSING - STANDARISASI ASAL DAERAH"],"metadata":{"id":"ppE1XM_62QO_"}},{"cell_type":"code","source":["data['Asal Daerah Bersih'] = (\n","    data['Asal Daerah']\n","    .astype('string')\n","    .str.strip()\n","    .str.replace(r'\\s+', ' ', regex=True)\n","    .str.title()\n",")\n","\n","print(\"\\nHasil Standarisasi Asal Daerah:\")\n","print(data[['Asal Daerah', 'Asal Daerah Bersih']].head(15))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"yszgSPjQ2U1f","executionInfo":{"status":"ok","timestamp":1790865759946,"user_tz":-420,"elapsed":30,"user":{"displayName":"Rivaldo Putra","userId":"00887201100226386037"}},"outputId":"e80a3a7e-1bd8-43f3-b320-37ecb48bb271"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Hasil Standarisasi Asal Daerah:\n","   Asal Daerah Asal Daerah Bersih\n","0      Jakarta            Jakarta\n","1     Surabaya           Surabaya\n","2       Malang             Malang\n","3      Bandung            Bandung\n","4      Jakarta            Jakarta\n","5     Semarang           Semarang\n","6      Jakarta            Jakarta\n","7      Bandung            Bandung\n","8     Surabaya           Surabaya\n","9       Malang             Malang\n","10     Jakarta            Jakarta\n","11         NaN               <NA>\n","12    Makassar           Makassar\n","13    Surabaya           Surabaya\n","14     Jakarta            Jakarta\n"]}]},{"cell_type":"markdown","source":["# 8. DATA CLEANSING - STANDARISASI DESTINASI"],"metadata":{"id":"GSIklxVh2Ylz"}},{"cell_type":"code","source":["data['Destinasi Bersih'] = (\n","    data['Destinasi']\n","    .astype('string')\n","    .str.strip()\n","    .str.replace(r'\\s+', ' ', regex=True)\n","    .str.title()\n",")\n","\n","print(\"\\nHasil Standarisasi Destinasi:\")\n","print(data[['Destinasi', 'Destinasi Bersih']].head(15))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"J_ARdpYp2cdI","executionInfo":{"status":"ok","timestamp":1790865763811,"user_tz":-420,"elapsed":57,"user":{"displayName":"Rivaldo Putra","userId":"00887201100226386037"}},"outputId":"573f3461-9294-4994-bc0a-917fef655d03"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Hasil Standarisasi Destinasi:\n","      Destinasi Destinasi Bersih\n","0   Labuan Bajo      Labuan Bajo\n","1          Bali             Bali\n","2         Bromo            Bromo\n","3    Yogyakarta       Yogyakarta\n","4   labuan bajo      Labuan Bajo\n","5          Bali             Bali\n","6   Labuan Bajo      Labuan Bajo\n","7         Bromo            Bromo\n","8    Yogyakarta       Yogyakarta\n","9          BALI             Bali\n","10         Bali             Bali\n","11  Labuan Bajo      Labuan Bajo\n","12  Labuan bajo      Labuan Bajo\n","13   Yogyakarta       Yogyakarta\n","14        Bromo            Bromo\n"]}]},{"cell_type":"markdown","source":["# 9. DATA CLEANSING - STANDARISASI UMUR"],"metadata":{"id":"ep_VThHP2fm_"}},{"cell_type":"code","source":["def clean_age(age):\n","    if pd.isna(age):\n","        return np.nan\n","\n","    age = str(age).strip().lower()\n","\n","    if age == 'dua puluh lima':\n","        return 25\n","\n","    try:\n","        return int(float(age))\n","    except:\n","        return np.nan\n","\n","\n","data['Umur Bersih'] = data['Umur'].apply(clean_age)\n","\n","print(\"\\nHasil Standarisasi Umur:\")\n","print(data[['Umur', 'Umur Bersih']].head(15))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"tWb_ebkn2ldo","executionInfo":{"status":"ok","timestamp":1790865767439,"user_tz":-420,"elapsed":110,"user":{"displayName":"Rivaldo Putra","userId":"00887201100226386037"}},"outputId":"fbf09e15-7a53-4e95-a8dd-fe30e7e542cb"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Hasil Standarisasi Umur:\n","   Umur  Umur Bersih\n","0    22         22.0\n","1    21         21.0\n","2    25         25.0\n","3    23         23.0\n","4   NaN          NaN\n","5    24         24.0\n","6    22         22.0\n","7    29         29.0\n","8    20         20.0\n","9    27         27.0\n","10   31         31.0\n","11   22         22.0\n","12   26         26.0\n","13   19         19.0\n","14   34         34.0\n"]}]},{"cell_type":"markdown","source":["# 10. DATA CLEANSING - STANDARISASI LAMA KUNJUNGAN"],"metadata":{"id":"sHon9jAv2rSj"}},{"cell_type":"code","source":["def clean_duration(duration):\n","    if pd.isna(duration):\n","        return np.nan\n","\n","    duration = str(duration).strip().lower()\n","\n","    # Mengambil angka saja\n","    duration = re.sub(r'[^0-9]', '', duration)\n","\n","    if duration == '':\n","        return np.nan\n","\n","    return int(duration)\n","\n","\n","data['Lama Kunjungan Bersih'] = (\n","    data['Lama Kunjungan'].apply(clean_duration)\n",")\n","\n","print(\"\\nHasil Standarisasi Lama Kunjungan:\")\n","print(data[['Lama Kunjungan', 'Lama Kunjungan Bersih']].head(15))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"C1J30Bm52usq","executionInfo":{"status":"ok","timestamp":1790865771001,"user_tz":-420,"elapsed":63,"user":{"displayName":"Rivaldo Putra","userId":"00887201100226386037"}},"outputId":"6afda8ab-7a01-4b26-bd82-5669a8a20d21"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Hasil Standarisasi Lama Kunjungan:\n","   Lama Kunjungan  Lama Kunjungan Bersih\n","0               3                    3.0\n","1               4                    4.0\n","2               2                    2.0\n","3               3                    3.0\n","4               5                    5.0\n","5          4 hari                    4.0\n","6               3                    3.0\n","7               2                    2.0\n","8               3                    3.0\n","9               5                    5.0\n","10              4                    4.0\n","11              3                    3.0\n","12              6                    6.0\n","13            NaN                    NaN\n","14              2                    2.0\n"]}]},{"cell_type":"markdown","source":["# 11. DATA CLEANSING - STANDARISASI BIAYA"],"metadata":{"id":"e0-qu3nx21J8"}},{"cell_type":"code","source":["def clean_cost(cost):\n","    if pd.isna(cost):\n","        return np.nan\n","\n","    cost = str(cost).strip()\n","\n","    # Menghapus titik dan koma\n","    cost = cost.replace('.', '').replace(',', '')\n","\n","    try:\n","        return float(cost)\n","    except:\n","        return np.nan\n","\n","\n","data['Biaya Bersih'] = data['Biaya'].apply(clean_cost)\n","\n","print(\"\\nHasil Standarisasi Biaya:\")\n","print(data[['Biaya', 'Biaya Bersih']].head(15))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"pP_YKSBY2477","executionInfo":{"status":"ok","timestamp":1790865774607,"user_tz":-420,"elapsed":68,"user":{"displayName":"Rivaldo Putra","userId":"00887201100226386037"}},"outputId":"90df2d91-932e-4fac-fe02-4a7e7176f144"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout